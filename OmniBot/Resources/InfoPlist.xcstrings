{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleName": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera needs to create and manage the alarms you authorize."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera 需要创建和管理你授权的闹钟。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera reads, creates, and manages calendar events only when you explicitly ask."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera 仅在你明确要求时读取、创建和管理日历事件。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera uses the camera to scan QR codes in tools. Results are processed only on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera 使用相机扫描工具中的二维码，识别结果仅在本机处理。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera finds, creates, and manages contacts only when you explicitly ask."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera 仅在你明确要求时查找、创建和管理联系人。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera uses Face ID to unlock the two-factor authentication accounts stored on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera 使用面容 ID 解锁你保存在本机的两步认证账户。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera reads only the health and fitness data you authorize, and only when you explicitly ask, to answer your questions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera 仅在你明确要求时读取你授权的健康与健身数据，以回答相关问题。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera does not write or modify your health data. HealthKit is used only to read the health and fitness data you explicitly authorize."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Via Vera 不会写入或修改你的健康数据；HealthKit 仅用于读取你明确授权的健康与健身数据。"
          }
        }
      }
    }
  },
  "version": "1.1"
}
